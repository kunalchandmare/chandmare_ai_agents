"""
Pipeline orchestrator for {{ project_name }}.
Driven by Hydra config (params.yaml). Run with:

    mlflow run . -P steps=all
    mlflow run . -P steps=download,training
    mlflow run . -P hydra_options="training.epochs=20"
"""
import os
import mlflow
import hydra
from omegaconf import DictConfig
{% if artifact_backend == 'wandb' %}
import wandb
{% endif %}

_steps = [
{%- for name in step_names %}
    "{{ name }}",
{%- endfor %}
{%- for name in component_names %}
    "{{ name }}",
{%- endfor %}
]


@hydra.main(version_base=None, config_name="params", config_path=".")
def go(config: DictConfig):
{% if artifact_backend == 'wandb' %}
    os.environ["WANDB_PROJECT"] = config["main"]["project_name"]
    os.environ["WANDB_RUN_GROUP"] = config["main"]["experiment_name"]
{% endif %}

    steps_par = config["main"]["steps"]
    active_steps = steps_par.split(",") if steps_par != "all" else _steps

    # ── src/ steps ─────────────────────────────────────────────────────────────
{% for step_name, step_cfg in steps.items() %}
    if "{{ step_name }}" in active_steps:
        mlflow.run(
            os.path.join(hydra.utils.get_original_cwd(), "src", "{{ step_name }}"),
            "main",
            env_manager="local",
            parameters={
{% for arg_name, arg_cfg in (step_cfg.get('arguments', {}) or {}).items() %}
                "{{ arg_name }}": str(config["{{ step_name }}"]["{{ arg_name }}"]),
{% endfor %}
            },
        )

{% endfor %}
    # ── components/ ────────────────────────────────────────────────────────────
{% for comp_name, comp_cfg in components.items() %}
    if "{{ comp_name }}" in active_steps:
        mlflow.run(
            os.path.join(hydra.utils.get_original_cwd(), "components", "{{ comp_name }}"),
            "main",
            env_manager="local",
            parameters={
{% for arg_name, arg_cfg in (comp_cfg.get('arguments', {}) or {}).items() %}
                "{{ arg_name }}": str(config["{{ comp_name }}"]["{{ arg_name }}"]),
{% endfor %}
            },
        )

{% endfor %}

if __name__ == "__main__":
    go()
