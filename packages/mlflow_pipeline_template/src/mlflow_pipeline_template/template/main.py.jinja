"""
Pipeline orchestrator for {{ project_name }}.
Driven by Hydra config (params.yaml). Run with:

    mlflow run . -P steps=all
    mlflow run . -P steps=download,training
    mlflow run . -P hydra_options="training.epochs=20"
"""
import os
import mlflow
import hydra
from omegaconf import DictConfig
{% if tracking_backend == 'wandb' %}
import wandb
{% endif %}

_steps = [
{%- for name in step_names %}
    "{{ name }}",
{%- endfor %}
{%- for name in component_names %}
    "{{ name }}",
{%- endfor %}
]

@hydra.main(version_base=None, config_name="params", config_path=".")
def go(config: DictConfig):
    main_cfg = config.get("main", {})
{%- if tracking_backend == 'wandb' %}
    os.environ["WANDB_PROJECT"] = str(main_cfg.get("project_name", ""))
    os.environ["WANDB_RUN_GROUP"] = str(main_cfg.get("experiment_name", "dev"))
{%- endif %}
    steps_par = str(main_cfg.get("steps", "all"))
    active_steps = [s.strip() for s in steps_par.split(",") if s.strip()] if steps_par != "all" else _steps

    # ── src/ steps ─────────────────────────────────────────────────────────────
{%- for step_name, step_cfg in steps.items() %}
    if "{{ step_name }}" in active_steps:
        step_cfg_runtime = config.get("{{ step_name }}", {})
    {%- set multiplicity_arg = None -%}
    {%- set multiplicity_sub_args = None -%}
    {%- set multiplicity_sub_arg_defaults = {} -%}
    {%- set arg_default_literals = step_cfg.arg_default_literals or {} -%}
    {%- if step_cfg.multiplicity_arg is defined and step_cfg.multiplicity_arg %}
        {%- set multiplicity_arg = step_cfg.multiplicity_arg -%}
        {%- set multiplicity_sub_args = step_cfg.multiplicity_sub_args -%}
        {%- set multiplicity_sub_arg_defaults = step_cfg.multiplicity_sub_arg_defaults or {} -%}
    {%- endif %}
    {%- if multiplicity_arg and multiplicity_sub_args %}
        for entry in step_cfg_runtime.get("{{ multiplicity_arg }}", []):
            mlflow.run(
                os.path.join(hydra.utils.get_original_cwd(), "src", "{{ step_name }}"),
                "main",
                env_manager="local",
                parameters={
{%- for sub_arg_name in multiplicity_sub_args %}
                    "{{ sub_arg_name }}": str((entry or {}).get("{{ sub_arg_name }}", {{ multiplicity_sub_arg_defaults.get(sub_arg_name, "''") }})),
{%- endfor %}
                },
            )
    {%- else %}
        mlflow.run(
            os.path.join(hydra.utils.get_original_cwd(), "src", "{{ step_name }}"),
            "main",
            env_manager="local",
            parameters={
{%- for arg_name, arg_cfg in (step_cfg.get('arguments', {}) or {}).items() %}
                "{{ arg_name }}": str(step_cfg_runtime.get("{{ arg_name }}", {{ arg_default_literals.get(arg_name, "''") }})),
{%- endfor %}
            },
        )
    {%- endif %}
{%- endfor %}
    # ── components/ ────────────────────────────────────────────────────────────
{%- for comp_name, comp_cfg in components.items() %}
    if "{{ comp_name }}" in active_steps:
        comp_cfg_runtime = config.get("{{ comp_name }}", {})
    {%- set multiplicity_arg = None -%}
    {%- set multiplicity_sub_args = None -%}
    {%- set multiplicity_sub_arg_defaults = {} -%}
    {%- set arg_default_literals = comp_cfg.arg_default_literals or {} -%}
    {%- if comp_cfg.multiplicity_arg is defined and comp_cfg.multiplicity_arg %}
        {%- set multiplicity_arg = comp_cfg.multiplicity_arg -%}
        {%- set multiplicity_sub_args = comp_cfg.multiplicity_sub_args -%}
        {%- set multiplicity_sub_arg_defaults = comp_cfg.multiplicity_sub_arg_defaults or {} -%}
    {%- endif %}
    {%- if multiplicity_arg and multiplicity_sub_args %}
        for entry in comp_cfg_runtime.get("{{ multiplicity_arg }}", []):
            mlflow.run(
                os.path.join(hydra.utils.get_original_cwd(), "components", "{{ comp_name }}"),
                "main",
                env_manager="local",
                parameters={
{%- for sub_arg_name in multiplicity_sub_args %}
                    "{{ sub_arg_name }}": str((entry or {}).get("{{ sub_arg_name }}", {{ multiplicity_sub_arg_defaults.get(sub_arg_name, "''") }})),
{%- endfor %}
                },
            )
    {%- else %}
        mlflow.run(
            os.path.join(hydra.utils.get_original_cwd(), "components", "{{ comp_name }}"),
            "main",
            env_manager="local",
            parameters={
{%- for arg_name, arg_cfg in (comp_cfg.get('arguments', {}) or {}).items() %}
                "{{ arg_name }}": str(comp_cfg_runtime.get("{{ arg_name }}", {{ arg_default_literals.get(arg_name, "''") }})),
{%- endfor %}
            },
        )
    {%- endif %}
{%- endfor %}
if __name__ == "__main__":
    go()
