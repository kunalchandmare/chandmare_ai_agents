name: {{ step_name }}
conda_env: conda.yaml

entry_points:
  main:
    parameters:
      run_name:
        description: "Pipeline group id propagated from the root orchestrator"
        type: string
        default: ""
{% for arg_name, arg_cfg in arguments.items() %}
{% if arg_cfg.get('multiplicity', False) %}
{% set sub_args = arg_cfg.get('args', []) %}
{% for sub_arg in sub_args %}
{% for sub_name, sub_cfg in sub_arg.items() %}
      {{ sub_name }}:
        description: "{{ sub_cfg.get('description', '') }}"
        type: {% set t = sub_cfg.get('type', 'str') %}{% if sub_cfg.get('is_nullable', false) %}string{% elif t == 'str' %}string{% elif t == 'int' or t == 'float' %}float{% elif t == 'bool' %}string{% else %}{{ t }}{% endif %}
{% if not sub_cfg.get('required', false) %}
        default: {% if sub_cfg.get('is_nullable', false) %}""{% else %}"{{ sub_cfg.get('default', '') }}"{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% else %}
      {{ arg_name }}:
        description: "{{ arg_cfg.get('description', '') }}"
        type: {% set t = arg_cfg.get('type', 'str') %}{% if arg_cfg.get('is_nullable', false) %}string{% elif t == 'str' %}string{% elif t == 'int' or t == 'float' %}float{% elif t == 'bool' %}string{% else %}{{ t }}{% endif %}
{% if not arg_cfg.get('required', false) %}
        default: {% if arg_cfg.get('is_nullable', false) %}""{% else %}"{{ arg_cfg.get('default', '') }}"{% endif %}
{% endif %}
{% endif %}
{% endfor %}
    command: >-
      python run.py --run_name {run_name}{% for arg_name, arg_cfg in arguments.items() %}{% if arg_cfg.get('multiplicity', False) %}{% set sub_args = arg_cfg.get('args', []) %}{% for sub_arg in sub_args %}{% for sub_name, sub_cfg in sub_arg.items() %} --{{ sub_name }} {{'{'}}{{ sub_name }}{{'}'}}{% endfor %}{% endfor %}{% else %} --{{ arg_name }} {{'{'}}{{ arg_name }}{{'}'}}{% endif %}{% endfor %}
