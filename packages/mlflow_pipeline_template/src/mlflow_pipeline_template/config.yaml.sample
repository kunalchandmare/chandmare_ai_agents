# config.yaml — Project-level configuration
# Copy this file, fill in your values, and pass to the template agent.

# Required: project name
project_name: "my_ml_project"

# Experiment tracking backend: mlflow (default) | wandb
# Controls where metrics, parameters, and run metadata are logged.
tracking_backend: "mlflow"

# Artifact storage backend: dvc (default)
# Controls where large files/artifacts are stored and versioned.
artifact_backend: "dvc"

# MLflow version (used when tracking_backend = "mlflow")
mlflow_version: "2.14.1"

# DVC remote (used when artifact_backend = "dvc")
# dvc_remote: "s3://my-bucket/artifacts"
# NOTE: On Windows, use forward slashes or single quotes for local paths:
#   dvc_remote: 'C:\Data\my_artifacts'   ← single quotes (no escaping)
#   dvc_remote: "C:/Data/my_artifacts"   ← forward slashes in double quotes

# --- Only when tracking_backend = "wandb" (MLflow orchestration still applies) ---
# wandb_entity: "myteam"
# wandb_project: "my_ml_project"
# wandb_version: "0.17.0"

